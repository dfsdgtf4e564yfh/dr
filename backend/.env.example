# Django
DJANGO_SECRET_KEY=your-secret-key-here-min-50-chars-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Database (set USE_POSTGRES=True for PostgreSQL in production)
USE_POSTGRES=True
DB_NAME=clinic_db
DB_USER=clinic_user
DB_PASSWORD=clinic_password
DB_HOST=db
DB_PORT=5432

# Redis (required for caching, Celery, rate limiting)
REDIS_URL=redis://:your-redis-password@redis:6379/0
REDIS_PASSWORD=your-redis-password
CELERY_BROKER_URL=redis://:your-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@redis:6379/1

# CORS / CSRF (set your actual domain)
CORS_ALLOWED_ORIGINS=http://localhost:80,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost:80,https://yourdomain.com
DOMAIN=yourdomain.com

# SMS Provider (melipayamak, amootsms)
SMS_PROVIDER=melipayamak
SMS_API_BASE=https://console.melipayamak.com/api
SMS_LINE_NUMBER=

# Backup
BACKUP_DIR=./backups

# Cloud Backup (optional)
CLOUD_BACKUP_ENABLED=False
CLOUD_BACKUP_PROVIDER=google_drive
GOOGLE_DRIVE_CREDENTIALS_FILE=
GOOGLE_DRIVE_BACKUP_FOLDER_ID=
DROPBOX_ACCESS_TOKEN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_REGION=us-east-1

# Encryption key for sensitive data (if unset, derived from DJANGO_SECRET_KEY)
ENCRYPTION_KEY=

# Sentry (optional error tracking)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.5

# Security (production)
SECURE_SSL_REDIRECT=True

# Alerting
ALERT_EMAIL_RECIPIENTS=
DEFAULT_FROM_EMAIL=noreply@clinic.local

# Zarinpal Payment
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
FRONTEND_URL=http://localhost:80

# Performance
DB_CONN_MAX_AGE=300
